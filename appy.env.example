# Appy Docker settings.
# The start script copies this file to appy.env on first run. Edit appy.env, not this file.
# On a production server, set APPY_URL to your real domain and change both passwords
# BEFORE the first start (the database is created with them).

APPY_URL=http://localhost:8080
APPY_PORT=8080
APPY_DB_DATABASE=appy
APPY_DB_USERNAME=appy
APPY_DB_PASSWORD=appy_secret
APPY_DB_ROOT_PASSWORD=root_secret
APPY_AUTO_MIGRATE=true

# Folder that holds the Android build server. Leave as is if Builder/ sits next to this folder.
APPY_BUILDER_PATH=../Builder
